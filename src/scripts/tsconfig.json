{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "../../dist/scripts",
    "rootDir": "../",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "verbatimModuleSyntax": false,
    "strict": true,
    "noEmit": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": "..",
    "paths": {
      "~/*": ["./*"]
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "../../node_modules"]
}
